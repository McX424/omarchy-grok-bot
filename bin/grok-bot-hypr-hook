#!/usr/bin/env bash
# Idempotent SUPER+W soft-close registration for mcx424.grok-bot.
# install  — ensure dofile snippet in ~/.config/hypr/hyprland.lua (reload only if added)
# uninstall — remove snippet (reload only if removed)
# status — print present|missing
set -euo pipefail

ACTION="${1:-status}"
HYPR_LUA="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua"
MARKER_BEGIN="-- BEGIN mcx424.grok-bot soft-close"
MARKER_END="-- END mcx424.grok-bot soft-close"
PLUGIN_LUA_REL='omarchy/plugins/mcx424.grok-bot/hypr/mcx424-grok-bot.lua'

snippet() {
  cat <<SNIP

$MARKER_BEGIN
-- SUPER+W soft-closes Grok Bot to scratchpad (process stays alive).
do local path = (os.getenv("XDG_CONFIG_HOME") or os.getenv("HOME") .. "/.config")
  .. "/$PLUGIN_LUA_REL"
  local file = io.open(path, "r"); if file then file:close(); dofile(path) end end
$MARKER_END
SNIP
}

has_snippet() {
  [[ -f $HYPR_LUA ]] && grep -Fq "$MARKER_BEGIN" "$HYPR_LUA"
}

# Migrate older unmarked dofile (from earlier manual install) into marked block.
migrate_legacy() {
  [[ -f $HYPR_LUA ]] || return 0
  if grep -Fq "$MARKER_BEGIN" "$HYPR_LUA"; then
    return 0
  fi
  if grep -Fq 'mcx424.grok-bot/hypr/mcx424-grok-bot.lua' "$HYPR_LUA"; then
    # Strip legacy uncommented block lines referencing the plugin lua
    local tmp
    tmp=$(mktemp)
    awk '
      /Added by mcx424\.grok-bot/ { skip=1; next }
      skip && /dofile\(path\) end end/ { skip=0; next }
      skip && /mcx424\.grok-bot\/hypr\/mcx424-grok-bot\.lua/ { next }
      skip && /^do local path/ { next }
      skip && /local file = io.open/ { next }
      skip { next }
      { print }
    ' "$HYPR_LUA" >"$tmp"
    mv "$tmp" "$HYPR_LUA"
  fi
}

reload_hypr() {
  hyprctl reload >/dev/null 2>&1 || true
}

case "$ACTION" in
  status)
    if has_snippet; then echo present; else echo missing; fi
    ;;
  install)
    mkdir -p "$(dirname "$HYPR_LUA")"
    touch "$HYPR_LUA"
    migrate_legacy
    if has_snippet; then
      echo "already"
      exit 0
    fi
    snippet >>"$HYPR_LUA"
    reload_hypr
    echo "installed"
    ;;
  uninstall)
    if ! has_snippet; then
      # Still try legacy cleanup
      migrate_legacy
      if ! grep -Fq 'mcx424.grok-bot/hypr/mcx424-grok-bot.lua' "$HYPR_LUA" 2>/dev/null; then
        echo "absent"
        exit 0
      fi
    fi
    if [[ -f $HYPR_LUA ]] && has_snippet; then
      tmp=$(mktemp)
      awk -v b="$MARKER_BEGIN" -v e="$MARKER_END" '
        $0 == b { skip=1; next }
        $0 == e { skip=0; next }
        skip { next }
        { print }
      ' "$HYPR_LUA" >"$tmp"
      # drop trailing blank lines left by removal? keep simple
      mv "$tmp" "$HYPR_LUA"
      reload_hypr
      echo "removed"
    else
      echo "absent"
    fi
    ;;
  *)
    echo "Usage: grok-bot-hypr-hook install|uninstall|status" >&2
    exit 2
    ;;
esac
