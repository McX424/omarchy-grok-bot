{
  "schemaVersion": 1,
  "id": "mcx424.grok-bot",
  "name": "Grok Bot",
  "version": "1.3.8",
  "author": "McX424",
  "description": "Icon bar chip for the Grok Bot desktop app \u2014 toggle hide/show, tiled or floating. Does not embed the app.",
  "license": "MIT",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Grok Bot",
    "category": "Apps",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "command": "grok-bot",
      "windowClass": "grok-bot",
      "floatWidth": 875,
      "floatHeight": 600,
      "showLabel": false,
      "chipText": ""
    },
    "schema": [
      {
        "key": "command",
        "type": "string",
        "label": "Launch command (PATH)"
      },
      {
        "key": "windowClass",
        "type": "string",
        "label": "Hyprland window class"
      },
      {
        "key": "floatWidth",
        "type": "number",
        "label": "Float width (fraction of monitor or px)"
      },
      {
        "key": "floatHeight",
        "type": "number",
        "label": "Float height (fraction of monitor or px)"
      },
      {
        "key": "showLabel",
        "type": "bool",
        "label": "Show chip text"
      },
      {
        "key": "chipText",
        "type": "string",
        "label": "Chip text"
      }
    ]
  }
}
